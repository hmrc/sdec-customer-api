# microservice specific routes

GET         /customer                              uk.gov.hmrc.sdeccustomerapi.controller.CustomerController.getCustomer

POST        /thread-access                         uk.gov.hmrc.sdeccustomerapi.controller.ThreadController.requestAccess

GET         /api/v1/thread/:threadReference        uk.gov.hmrc.sdeccustomerapi.controller.ThreadController.getThread(threadReference: String)
PUT         /api/v1/thread/:threadReference        uk.gov.hmrc.sdeccustomerapi.controller.ThreadController.updateThread(threadReference: String)
